DJANGO_DEBUG=true
DJANGO_SECRET_KEY=replace-this-for-a-shared-installation
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1,testserver
DJANGO_CSRF_TRUSTED_ORIGINS=http://localhost:8000,http://127.0.0.1:8000

# demo never contacts Pishkhan and labels every response. live uses the observed API contracts.
P24_MODE=demo
P24_API_BASE_URL=https://core.pishkhan24.ayantech.ir/webservices
P24_API_TIMEOUT=30
P24_APPLICATION=pishkhan24
P24_ORIGIN=web
P24_PLATFORM=web
P24_VERSION=1.0.0
P24_DEVICE_PARAMETERS={}
# Empty uses Core's built-in return page. Custom URLs must be allowed by Core.
# Do not substitute the local MCP address unless that exact URL is approved upstream.
P24_PAYMENT_CALLBACK=

# Optional access key for a shared instance; not needed for localhost development.
P24_ACCESS_KEY=
MCP_ALLOWED_HOSTS=localhost:*,127.0.0.1:*,testserver

# PostgreSQL is optional. An empty DB_HOST uses SQLite.
DB_HOST=
DB_PORT=5432
DB_NAME=pishkhan
DB_USER=pishkhan
DB_PASSWORD=

# Claude API via Anthropic's OpenAI-compatible Chat Completions endpoint.
# Put a newly rotated key in this local .env only; never commit it.
AGENT_BASE_URL=https://api.anthropic.com/v1
AGENT_API_KEY=
AGENT_MODEL=claude-sonnet-4-6
AGENT_WORKSPACE_ID=
# Optional SOCKS5 proxy for model traffic only. Leave empty when not required.
AGENT_PROXY_URL=
# Ten user chat turns per Tehran-local day; tool calls within a turn count once.
AGENT_DAILY_MESSAGE_LIMIT=10
AGENT_MAX_STEPS=12
AGENT_TIMEOUT=90

# Preferred LAN start: python scripts/run_lan.py --ip YOUR_HOST_LAN_IP
# The launcher enables this and sets exact allowed hosts/origins for its process.
P24_LAN_MODE=false
# Per-model-response output cap; the global 10-message daily budget is unchanged.
AGENT_MAX_OUTPUT_TOKENS=1200
